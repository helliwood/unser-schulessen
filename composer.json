{
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-imagick": "*",
    "ext-json": "*",
    "beberlei/doctrineextensions": "^1.2",
    "doctrine/dbal": "^3.10",
    "doctrine/doctrine-bundle": "^2.13",
    "doctrine/doctrine-migrations-bundle": "^3.0",
    "doctrine/migrations": "^3.0",
    "doctrine/orm": "^2.20",
    "doctrine/persistence": "^3.3",
    "dompdf/dompdf": "^3.1",
    "endroid/qr-code-bundle": "^4.1",
    "knplabs/knp-menu-bundle": "^3.0",
    "phpdocumentor/reflection-docblock": "^5.3",
    "phpoffice/phpspreadsheet": "^1.9",
    "ramsey/uuid-doctrine": "^1.5",
    "scienta/doctrine-json-functions": "^6.3",
    "symfony/apache-pack": "^1.0",
    "symfony/asset": "6.4.*",
    "symfony/console": "6.4.*",
    "symfony/dotenv": "6.4.*",
    "symfony/expression-language": "6.4.*",
    "symfony/flex": "^2.4",
    "symfony/form": "6.4.*",
    "symfony/framework-bundle": "6.4.*",
    "symfony/http-client": "6.4.*",
    "symfony/monolog-bundle": "^3.1",
    "symfony/process": "6.4.*",
    "symfony/property-access": "6.4.*",
    "symfony/property-info": "6.4.*",
    "symfony/proxy-manager-bridge": "6.4.*",
    "symfony/security-bundle": "6.4.*",
    "symfony/brevo-mailer": "6.4.*",
    "symfony/serializer": "6.4.*",
    "symfony/translation": "6.4.*",
    "symfony/twig-bundle": "6.4.*",
    "symfony/validator": "6.4.*",
    "symfony/web-link": "6.4.*",
    "symfony/webpack-encore-bundle": "^2.4",
    "symfony/yaml": "6.4.*",
    "twig/extra-bundle": "^3.15"
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^3.2",
    "phpunit/phpunit": "^9.6",
    "slevomat/coding-standard": "^8.16",
    "squizlabs/php_codesniffer": "^3.4",
    "symfony/browser-kit": "6.4.*",
    "symfony/css-selector": "6.4.*",
    "symfony/debug-bundle": "6.4.*",
    "symfony/maker-bundle": "^1.0",
    "symfony/stopwatch": "6.4.*",
    "symfony/web-profiler-bundle": "6.4.*"
  },
  "config": {
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true,
    "allow-plugins": {
      "symfony/flex": true,
      "endroid/installer": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "replace": {
    "paragonie/random_compat": "2.*",
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*"
  },
  "scripts": {
    "cs-check": "phpcs -s -n --runtime-set ignore_warnings_on_exit true",
    "cs-fix": "phpcbf",
    "rebuild-testdb": "php bin/console doctrine:schema:drop --full-database --env=test --force && php bin/console doctrine:schema:update --force --env=test -n && php bin/console doctrine:fixtures:load --env=test --append",
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "6.4.*"
    }
  }
}
