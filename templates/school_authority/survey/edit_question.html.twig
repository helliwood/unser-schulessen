{% extends 'base.html.twig' %}

{% block body %}
    <div>
        <h1>Frage bearbeiten</h1>
        <div class="panel">
            <div class="row">
                <div class="d-none d-xl-block col-xl-1"></div>
                <div class="col-xl-10">
                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                    {{ form_row(form.question, {'attr': {'surveyState':survey.getState}}) }}
                    {% if form.choices is defined %}
                        <fieldset>
                            <legend>Antwortmöglichkeiten</legend>
                            <form-survey-question-choices :survey-state="{{ survey.getState }}" class="mb-2">
                                {{ form_widget(form.choices,{'attr':{'surveyState':survey.getState}} ) }}
                            </form-survey-question-choices>
                            {{ form_errors(form) }}
                        </fieldset>
                    {% endif %}
                    <div class="form-group row">
                        <div class="col-sm-3"></div>
                        <div class="col-sm-9 d-flex">
                            <button type="submit" id="save" name="save" class="btn-primary btn"><i class="far fa-save mr-1"></i>Speichern</button>
                            <a href="{{ path('school_authority_survey_questions', {id: survey.id}) }}" class="btn btn-secondary ml-2"><i class="fas fa-arrow-left mr-1"></i>Zurück</a>
                        </div>
                    </div>
                    {{ form_end(form) }}
                </div>
                <div class="d-none d-xl-block col-xl-1"></div>
            </div>
        </div>
    </div>
{% endblock %}
