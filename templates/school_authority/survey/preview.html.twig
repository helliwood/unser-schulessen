{% extends 'base.html.twig' %}

{% form_theme form _self %}

{% block form_label_class -%}
    col-sm-6 col-form-label
{%- endblock -%}

{% block form_group_class -%}
    col-sm-6
{%- endblock form_group_class %}

{% block body %}
    <div class="example-wrapper">
        <h1 class="text-center">{{ survey.name }}</h1>
        <h3 class="text-center">
            Vorschau – Abgabe nicht möglich
        </h3>
        <div class="panel">
            <h4 class="text-center mb-3">{{ survey.introduction }}</h4>
            <div class="row">
                <div class="d-none d-xl-block col-xl-1"></div>
                <div class="col-xl-10">
                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                    {{ form_widget(form) }}
                    <div class="form-group row">
                        <div class="col text-center">
                            <a href="{{ path('school_authority_surveys') }}" class="btn btn-secondary"><i class="fas fa-arrow-left mr-1"></i>Zurück</a>
                        </div>
                    </div>
                    {{ form_end(form) }}
                </div>
                <div class="d-none d-xl-block col-xl-1"></div>
            </div>
        </div>
    </div>
{% endblock %}
