{% extends 'base.html.twig' %}

{% block title %}Meine Schulen - Schulträger{% endblock %}

{% block body %}
    <div class="example-wrapper">
        <h1>Meine Schulen</h1>

        <div class="panel col-12">
            {% if hasSchoolAuthority %}
                <data-table
                        api-url="{{ path('school_authority_schools_ajax') }}"
                        :search="true"
                        sort-by="name"
                        :sort-desc="false"
                        :per-page="10"
                        :fields="[
                        {key: 'name', label: 'Schule', sortable: true},
                        {key: 'qualityCheck', label: 'QC', sortable: true},
                        {key: 'latestQcDate', label: 'lQC', sortable: true},
                        {key: 'latestToDoDate', label: 'lToDo', sortable: true},
                        {key: 'latestSurveyDate', label: 'lZU', sortable: true},
                        {key: 'options', label: 'Aktionen', sortable: false, class:'options'},
                    ]">
                    <template v-slot:cell(name)="row">
                        <span>{{ '{{' }} row.item.name {{ '}}' }}</span>
                        <span v-if="!row.item.authorityAccessAllowed" class="badge badge-secondary ml-2">Kein Zugriff</span>
                    </template>

                    <template v-slot:cell(qualityCheck)="row">
                        <div v-if="!row.item.authorityAccessAllowed">
                            <span class="text-muted">Kein Zugriff</span>
                        </div>
                        <div v-else-if="row.item.hasQualityCheck">
                            <div class="progress" style="height: 20px;">
                                <div class="progress-bar bg-success"
                                     role="progressbar"
                                     :style="'width: ' + row.item.qcTrue + '%'"
                                     :title="'Erfüllt: ' + row.item.qcTrue + '%'">
                                    {{ '{{' }} row.item.qcTrue.toFixed(2) {{ '}}' }}%
                                </div>
                                <div class="progress-bar bg-warning"
                                     role="progressbar"
                                     :style="'width: ' + row.item.qcPartial + '%'"
                                     :title="'Teilweise erfüllt: ' + row.item.qcPartial + '%'">
                                    {{ '{{' }} row.item.qcPartial.toFixed(2) {{ '}}' }}%
                                </div>
                                <div class="progress-bar bg-danger"
                                     role="progressbar"
                                     :style="'width: ' + row.item.qcFalse + '%'"
                                     :title="'Nicht erfüllt: ' + row.item.qcFalse + '%'">
                                    {{ '{{' }} row.item.qcFalse.toFixed(2) {{ '}}' }}%
                                </div>
                                <div v-if="row.item.qcNotAnswered > 0"
                                     class="progress-bar"
                                     role="progressbar"
                                     :style="{ backgroundColor: '#adb5bd', width: row.item.qcNotAnswered + '%' }"
                                     :title="'Nicht beantwortet: ' + row.item.qcNotAnswered + '%'">
                                    {{ '{{' }} row.item.qcNotAnswered.toFixed(2) {{ '}}' }}%
                                </div>
                            </div>
                            <small class="text-muted d-block mt-1">
                                <strong>{{ '{{' }} row.item.countAnswered {{ '}}' }} Kriterien von {{ '{{' }} row.item.countQuestions {{ '}}' }} Gesamtkriterien bewertet:</strong>
                                <br>
                                <span class="text-success">{{ '{{' }} row.item.countTrue {{ '}}' }} Erfüllt</span>,
                                <span class="text-warning">{{ '{{' }} row.item.countPartial {{ '}}' }} Teilweise erfüllt</span>,
                                <span class="text-danger">{{ '{{' }} row.item.countFalse {{ '}}' }} Nicht erfüllt</span>,
                                <span style="color: #adb5bd;">{{ '{{' }} row.item.countNotAnswered {{ '}}' }} Nicht beantwortet</span>
                                <br>
                                <strong>{{ '{{' }} row.item.answeredMainCategories {{ '}}' }} von {{ '{{' }} row.item.totalMainCategories {{ '}}' }} Qualitätsfeldern bewertet.</strong>
                            </small>
                        </div>
                        <span v-else class="text-muted">Kein Qualitäts-Check vorhanden</span>
                    </template>

                    <template v-slot:cell(latestQcDate)="row">
                        <span v-if="row.item.latestQcDate !== '-'">{{ '{{' }} row.item.latestQcDate {{ '}}' }}</span>
                        <span v-else class="text-muted">-</span>
                    </template>

                    <template v-slot:cell(latestToDoDate)="row">
                        <span v-if="row.item.latestToDoDate !== '-'">{{ '{{' }} row.item.latestToDoDate {{ '}}' }}</span>
                        <span v-else class="text-muted">-</span>
                    </template>

                    <template v-slot:cell(latestSurveyDate)="row">
                        <span v-if="row.item.latestSurveyDate !== '-'">{{ '{{' }} row.item.latestSurveyDate {{ '}}' }}</span>
                        <span v-else class="text-muted">-</span>
                    </template>

                    <template v-slot:cell(options)="row">
                        <div v-if="row.item.authorityAccessAllowed">
                            <b-button size="sm" :href="'/schultraeger/schule/' + row.item.id" class="mr-2">
                                Anzeigen
                            </b-button>
                        </div>
                        <span v-else class="text-muted">Kein Zugriff</span>
                    </template>
                </data-table>
                <div class="mt-3">
                    <small class="text-muted">
                        <strong>Legende:</strong>
                        <strong>QC:</strong> Qualitäts-Check |
                        <strong>lQC:</strong> letzter Qualitäts-Check |
                        <strong>lToDo:</strong> letztes ToDo |
                        <strong>lZU:</strong> letzte Zufriedenheitsumfrage
                    </small>
                </div>

            {% else %}
                <div class="alert alert-warning">
                    Sie sind keinem Schulträger zugeordnet.
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %} 
